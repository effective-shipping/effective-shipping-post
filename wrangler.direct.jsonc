{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twofold",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twofold-db",
      "database_id": "b9f838b6-3198-4f86-8e5c-d3594012a080",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "LINKEDIN_VERSION": "202608"
  },
  "routes": [
    {
      "pattern": "twofold.ilijaristovski.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
